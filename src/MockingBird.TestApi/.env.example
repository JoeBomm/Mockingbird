# Copy this file to .env (git-ignored) and fill in the values you need.
# Loaded automatically on startup via DotNetEnv (see Program.cs), using the ASP.NET Core
# double-underscore convention to map onto configuration keys under the "MockingBird" section.

# Which provider to use: "OpenRouter" (default) or "Bedrock".
MockingBird__Provider=OpenRouter

# OpenRouter (used when Provider=OpenRouter). Leave blank to fall back to the deterministic
# offline provider.
MockingBird__OpenRouterApiKey=

# Amazon Bedrock (used when Provider=Bedrock). Leave AccessKeyId/SecretAccessKey blank to use the
# AWS SDK's default credential chain (env vars, shared credentials file, instance/task role, etc.)
# instead of supplying them here.
MockingBird__Bedrock__AccessKeyId=
MockingBird__Bedrock__SecretAccessKey=
MockingBird__Bedrock__Region=us-east-1
MockingBird__Bedrock__ModelId=anthropic.claude-3-5-haiku-20241022-v1:0
